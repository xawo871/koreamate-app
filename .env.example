# KoreaMate backend environment template

# Keep secrets on the server only.
# Do not commit real values into Git.

APP_ENV=development
APP_PORT=8000

# Krdict API credentials - server-side only
# Replace with the official provider endpoint and key provided by the dictionary service.
KRDICT_API_KEY=your_krdict_api_key_here
KRDICT_BASE_URL=https://example.com/krdict

# Optional server settings
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=15
MAX_REQUESTS_PER_MINUTE=60
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
